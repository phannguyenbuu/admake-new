[Unit]
Description=GenAI desktop window manager
Requires=genai-desktop-desktop.service
After=genai-desktop-desktop.service
[Service]
User=genai-desktop
Environment=HOME=/var/lib/genai-desktop
Environment=DISPLAY=:12
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
