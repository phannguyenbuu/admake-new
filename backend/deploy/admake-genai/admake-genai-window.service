[Unit]
Description=Admake desktop window manager
Requires=admake-genai-desktop.service
After=admake-genai-desktop.service
[Service]
User=admake-genai
Environment=HOME=/var/lib/admake-genai
Environment=DISPLAY=:12
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
